<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tigerevents.update</string>

  <!-- REPLACE the path below with wherever you cloned the repo. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/YOUR_USERNAME/tiger-events/update_events.py</string>
  </array>

  <!-- Every 4 hours. If the Mac was asleep when a run was due,
       launchd fires it once on wake instead of skipping it. -->
  <key>StartInterval</key>
  <integer>14400</integer>

  <!-- Also run once right after login, so a fresh boot catches up. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Logs. Check these if you suspect it stopped running. -->
  <key>StandardOutPath</key>
  <string>/tmp/tigerevents.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tigerevents.err</string>
</dict>
</plist>
